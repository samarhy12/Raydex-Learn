# Copy this file to .env and fill in your values. .env is gitignored.

SECRET_KEY=
# DATABASE_URL=sqlite:///instance/raydex.db
SITE_URL=https://learn.raydexhub.com
# COOKIE_SECURE=0
# Google OAuth web client credentials. See README.md for callback setup.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ADMIN_EMAILS=
# SUPPORT_EMAIL=the-inbox-that-receives-course-questions@example.com
# FLASK_DEBUG=0
# Gmail / Google Workspace SMTP (configure the app password locally)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use the Gmail account that owns the app password
SMTP_USER=
SMTP_PASS=
# Must be that account or an authorized "Send mail as" alias
MAIL_FROM=
